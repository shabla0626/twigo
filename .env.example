# ---------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit .env.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------

# PostgreSQL connection string.
# This is the DEVELOPMENT database. Production uses its own database, created empty
# (docs/DEPLOYMENT.md, section 6); never point a production server at a development database.
# Local dev with the bundled embedded server (npm run db:up):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/cowork?schema=public"

# Public base URL (canonical URLs, emails, WebSocket origin check, CSP).
SITE_URL="http://localhost:3000"
# Production: SITE_URL="https://twigo.space" (exactly this spelling: no "www.", no trailing slash).
# Production server: VPS 162.35.23.106, reached with `ssh shabla@162.35.23.106` (see docs/DEPLOYMENT.md, section 0).
# Port / interface for `npm start` (server.ts).
# Development uses 3000; production (Docker) uses 1010, see .env.production.example.
PORT="3000"
# How many reverse proxies stand in front of the app and add to X-Forwarded-For.
# 0 = none (the app is reached directly). 1 = one proxy such as Caddy or nginx.
# Twigo production (Cloudflare proxy + the server's central Caddy): 2, as long as the server only accepts
# web traffic from Cloudflare (docs/DEPLOYMENT.md, section 5).
# Sign-in and form attempt limits count per visitor address; a wrong number makes all visitors look like one.
TRUSTED_PROXY_HOPS="0"

# Signs form tokens and hashes IP addresses. At least 32 characters.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Encrypts two-factor secrets at rest. Required in production; must differ from AUTH_SECRET.
ENCRYPTION_KEY=""

# Session lifetimes (hours): administrators / members.
SESSION_TTL_HOURS="8"
MEMBER_SESSION_TTL_HOURS="336"
# Administrators must use two-step verification (TOTP) to open /admin.
ADMIN_REQUIRE_2FA="true"

# ---- Branding (one place; see src/config/brand.ts) ----
# ORG_NAME is a WORKING NAME. Replace with the final brand name.
ORG_NAME="Twigo"
ORG_TAGLINE="Together We Innovate, Grow & Opportunity"
ORG_LEGAL_NAME=""
ORG_JURISDICTION=""
ORG_CONTACT_EMAIL=""

# ---- Email (SMTP): Resend ----  full guide: docs/EMAIL.md
# Production sends through Resend SMTP (domain twigo.space verified in Resend).
# SMTP_PASSWORD is the Resend API key. Leave it empty here; never commit a real key.
# While it is empty, no connection is attempted and every attempt is recorded as
# "Not sent: email not set up" with the reason (Admin -> Email). Nothing is reported as sent.
#
# Development (`npm run dev`): ALL email goes to the local test inbox (http://127.0.0.1:8025),
# whatever the values below say, so a real key in .env never sends real email from a development
# computer. Set DEV_MAIL_CATCHER="false" only to test the real provider from this computer.
# Production (`npm start`) never uses the local test inbox.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM="Twigo <noreply@twigo.space>"
EMAIL_FROM_NAME=""
ADMIN_NOTIFICATION_EMAIL=""
# Resend webhook signing secret (starts with "whsec_"), from Resend -> Webhooks, for confirmed
# "Delivered" statuses at https://twigo.space/api/email/webhook. It is NOT the API key. Optional.
RESEND_WEBHOOK_SECRET=""
# Development only: "false" stops `npm run dev` from using the local test inbox. DEV_MAIL_PORT
# (default 2525) and DEV_MAIL_UI_PORT (default 8025) move it to other ports.
DEV_MAIL_CATCHER="true"
SEND_APPLICANT_CONFIRMATION="true"

# ---- Files ----
# Private uploads (never under /public). Use durable storage in production.
STORAGE_DIR="storage"
MAX_UPLOAD_MB="10"

# ---- Background jobs (retention + backup, daily, inside server.ts) ----
JOBS_ENABLED="true"
BACKUP_DIR="backups"
BACKUP_KEEP="14"
# Optional but recommended: encrypts backup files (AES-256-GCM).
BACKUP_ENCRYPTION_KEY=""

# Retention periods are configured by the owner at /admin/settings.
# RETENTION_DAYS_DECLINED is kept for backward compatibility only.
RETENTION_DAYS_DECLINED="365"
