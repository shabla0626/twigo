# Twigo production settings (template). On the server: copy to .env.production, fill in, and never
# commit the filled-in file (.gitignore excludes it). Used by docker-compose.yml for the build and at
# runtime. The site refuses to start while a required value is missing (it lists them).
# Values must not contain the $ character (Docker Compose would try to expand it).

# ---- Address and network ----
SITE_URL=https://twigo.space
# Next.js listens on 1010 (also fixed in docker-compose.yml): the only application port in production.
PORT=1010
HOST=0.0.0.0
# Cloudflare proxy + the server's central Caddy = 2 proxies. Use 1 if the Cloudflare proxy is turned
# off, and keep 2 only while the server accepts web traffic exclusively from Cloudflare.
TRUSTED_PROXY_HOPS=2

# ---- Database (the "db" service in docker-compose.yml) ----
# Letters and digits only, for example the output of: openssl rand -hex 24
POSTGRES_PASSWORD=
# DATABASE_URL is built from POSTGRES_PASSWORD in docker-compose.yml; do not set it here.

# ---- Secrets: generate each with  openssl rand -hex 32  (all different). Keep a copy in a password manager. ----
AUTH_SECRET=
# Losing ENCRYPTION_KEY disables everyone's two-step verification.
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# ---- Organization (required; never invent these) ----
# ORG_LEGAL_NAME is the name in the footer copyright; Twigo is not presented as a registered entity, and the
# "Legal operator name" on /legal/notices stays "Not yet confirmed" until the owner confirms it in Admin -> Legal.
# ORG_JURISDICTION is where the operator is established (shown on /legal/notices). It is NOT the governing law:
# the Terms of Use say that is not yet determined; only a reviewed Terms version can state it.
ORG_NAME=Twigo
ORG_TAGLINE=Together We Innovate, Grow & Opportunity
ORG_LEGAL_NAME=Twigo
ORG_JURISDICTION="Sacramento, California"
ORG_CONTACT_EMAIL=contact@twigo.space

# ---- Email: Resend SMTP (docs/EMAIL.md) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
# The Resend API key: the founder enters it after the = sign. While empty, nothing is sent and each
# attempt is recorded as "Not sent: email not set up".
SMTP_PASSWORD=
EMAIL_FROM="Twigo <noreply@twigo.space>"
ADMIN_NOTIFICATION_EMAIL=
# Optional: the Resend webhook signing secret (whsec_...), never the API key.
RESEND_WEBHOOK_SECRET=
SEND_APPLICANT_CONFIRMATION=true

# ---- Security and sessions ----
ADMIN_REQUIRE_2FA=true
SESSION_TTL_HOURS=8
MEMBER_SESSION_TTL_HOURS=336

# ---- Files, jobs and backups (paths are fixed in docker-compose.yml: /data/storage, /data/backups) ----
MAX_UPLOAD_MB=10
JOBS_ENABLED=true
BACKUP_KEEP=14
