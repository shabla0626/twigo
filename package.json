{
  "name": "remote-collab-company",
  "version": "0.1.0",
  "description": "Remote collaborative company website and founding-contributor recruitment system",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build --webpack",
    "start": "tsx server.ts --production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "tsx scripts/migrate.ts deploy",
    "admin:create": "tsx scripts/create-admin.ts",
    "legal:publish-reviewed": "tsx scripts/legal-publish-reviewed.ts",
    "purge:retention": "tsx scripts/purge-retention.ts",
    "postinstall": "prisma generate",
    "db:migration": "tsx scripts/migrate.ts new",
    "photos:status": "tsx scripts/photos-status.ts",
    "db:backup": "tsx scripts/backup.ts backup",
    "db:restore": "tsx scripts/backup.ts restore",
    "backup:artifact": "tsx scripts/backup-artifact.ts",
    "dev:next-only": "next dev --webpack",
    "test:e2e": "playwright test",
    "mail:dev": "tsx scripts/dev-mail.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "perf:measure": "tsx scripts/perf-measure.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "embedded-postgres": "^17.12.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "smtp-server": "^3.21.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/windows-x64@17.12.0-beta.19": true
  },
  "private": true
}
